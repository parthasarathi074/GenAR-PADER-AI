# ------------------------------------------------------------

frontend/node_modules/
frontend/dist/

node_modules/
dist/

npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# ------------------------------------------------------------
# IDE / Editor
